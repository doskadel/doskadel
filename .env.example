# Переменные docker-compose (Garage S3). Скопировать в .env, заполнить, НЕ коммитить.
# Бэкенд читает свои S3_* из backend/.env; ключи должны совпадать с GARAGE_*.

# Garage
GARAGE_RPC_SECRET=change_me_64_hex_chars
GARAGE_ADMIN_TOKEN=change_me_admin_token
GARAGE_ACCESS_KEY=change_me_access_key
GARAGE_SECRET_KEY=change_me_secret_key_at_least_16_chars
S3_BUCKET=doskadel-files
